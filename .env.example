# Шаблон локального окружения MAXoBOT
# Скопируйте в .env для локальной разработки и подставьте тестовые значения.
# Никогда не коммитьте реальные секреты.

# Обязательный токен бота (Authorization: Bearer <token>)
MAXOBOT_TOKEN=replace-with-dev-bot-token

# Базовый URL MAX API (только HTTPS)
MAXOBOT_API_BASE_URL=https://platform-api.max.ru

# Опциональный секрет проверки webhook
MAXOBOT_WEBHOOK_SECRET=replace-with-webhook-secret

# Политика retry
MAXOBOT_RETRY_MAX_ATTEMPTS=5
MAXOBOT_RETRY_BASE_DELAY_MS=200
MAXOBOT_RETRY_MAX_DELAY_MS=5000
MAXOBOT_RETRY_JITTER=true

# Политика rate-limit
MAXOBOT_RATE_LIMIT_RPS=30
MAXOBOT_RATE_LIMIT_BURST=30

# Опциональные значения polling (разработка/тесты)
MAXOBOT_POLLING_TIMEOUT_SECONDS=30
MAXOBOT_POLLING_LIMIT=100
